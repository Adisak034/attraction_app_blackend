# Frontend environment variables
# Set API_URL to your server address for port forwarding: http://YOUR_IP:8000 or https://example.com:8000
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID

# Backend environment variables
# For port forwarding/server deployment, list frontend URLs separated by commas
# Example: http://192.168.1.100:3000,https://example.com
CORS_ORIGINS=
